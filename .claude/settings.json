{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run python -m game.*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "mcp__ember__list_content",
      "mcp__ember__get_entity",
      "mcp__ember__simulate_fight",
      "mcp__ember__balance_report",
      "mcp__ember__validate_level_json",
      "mcp__ember__propose_entity",
      "mcp__blender__blender_ping",
      "mcp__blender__blender_scene_info",
      "mcp__unity__unity_ping",
      "mcp__unity__unity_scene_info",
      "mcp__unity__unity_screenshot"
    ],
    "ask": [
      "mcp__ember__save_level",
      "mcp__blender__blender_clear",
      "mcp__unity__unity_clear"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PROJECT_DIR}\" python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PROJECT_DIR}\" python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PROJECT_DIR}\" python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate_content.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PROJECT_DIR}\" python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.py\""
          }
        ]
      }
    ]
  }
}