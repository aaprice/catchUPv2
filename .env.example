# ================= [v2] pick ONE engine by profile (see lib/profiles.py) =================
# Home PC (Ollama):          qwen3-8b | qwen3.5-9b | gemma4-e4b | gemma4-12b | gemma4-26b | gpt-oss-20b
# Work workstation / DGX:    dgx-vllm | llamacpp | lmstudio | gemma4-26b (if Ollama at work)
# Free cloud (if allowed):   gemini
LLM_PROFILE=qwen3-8b

# Force tool-calling strategy regardless of profile: native | prompt  (prompt = schema-constrained JSON fallback)
# LLM_TOOL_MODE=prompt

# ---- Ollama ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384           # context window per request. Bigger = more VRAM. Agents want 16k-32k.
# LLM_THINK=0                  # qwen3/gpt-oss: 0 disables thinking. Gemma 4: thinking OFF unless <|think|> in system prompt.
EMBED_MODEL=nomic-embed-text   # or embeddinggemma

# ---- DGX (vLLM OpenAI-compatible server) ----
# DGX_URL=http://<dgx-hostname>:8000/v1
# DGX_MODEL=google/gemma-4-26b-it

# ---- llama.cpp / LM Studio custom port ----
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# ---- Gemini (personal key; check work policy) ----
# GEMINI_API_KEY=your-ai-studio-key

# ---- Legacy v1 style (used only when LLM_PROFILE unset) ----
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
